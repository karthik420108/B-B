# ---------------------------------------------------------------------------
# Health Wallet backend configuration (placeholders only - never commit real secrets)
# Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/health_wallet

# JWT secrets - use long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Public base URL used when building share / document links
PUBLIC_BASE_URL=http://localhost:4000

# Allowed CORS origins (comma separated). Flutter web dev server or your host.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# ---------------------------------------------------------------------------
# Storage adapter: `local` (default, no paid service required) or `s3`
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Only used when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# AI provider: `local` (default, offline extractive RAG), `openai`, or `anthropic`
# The application works fully offline with `local`. Cloud providers are optional.
# ---------------------------------------------------------------------------
AI_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Explicit acknowledgement required before document text is sent to a cloud AI provider.
AI_ALLOW_EXTERNAL_DATA_TRANSFER=false

# ---------------------------------------------------------------------------
# OCR / extraction
# ---------------------------------------------------------------------------
# Tesseract language data. `eng` is downloaded once and cached.
OCR_LANGUAGES=eng
OCR_CACHE_DIR=./.ocr-cache
# Max upload size in megabytes
MAX_UPLOAD_MB=25

# Drug interaction rules engine dataset. Shipped dataset is a curated subset of
# publicly documented interactions. Set to empty to disable and report "unavailable".
INTERACTION_DATASET=./data/interactions.json

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SENSITIVE_RATE_LIMIT_MAX=20
